<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MoreThan200</fullName>
    <active>true</active>
    <errorConditionFormula>ISNEW()  &amp;&amp;  NumberOfEmployees &gt; 200</errorConditionFormula>
    <errorMessage>Number of Employees are greater than 200</errorMessage>
</ValidationRule>
