<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Feedback</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, &quot;Scheduled&quot;) &amp;&amp; NOT(ISBLANK(TEXT(Feedback_Rating__c))) &amp;&amp;  isTrainingToday__c = FALSE</errorConditionFormula>
    <errorMessage>Feedback cannot be entered for scheduled training.</errorMessage>
</ValidationRule>
